# ShikshaGap Environment Variables Template
# Copy this file to .env.local and replace the placeholder values.
# NEVER commit .env.local or any file containing real API keys or secrets.

# ==============================================================================
# 1. CORE AI & APPLICATION SECRETS
# ==============================================================================
# Google Gemini API Key (Required for AI diagnostic assessment agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Session Signing Secret (Required in production - generate with `openssl rand -hex 32`)
# Used for HMAC-SHA256 signature verification of HttpOnly session cookies.
SESSION_SECRET=your_32_byte_random_session_secret_here

# IP Hashing Salt for Audit Logs (Required in production)
# Salt used for cryptographic pseudonymization of client IP addresses in DPDP audit logs.
IP_SALT=your_random_salt_for_ip_pseudonymization_here

# ==============================================================================
# 2. DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL Connection URL (e.g., Supabase, Neon, AWS RDS, or standard PostgreSQL)
# Used for persistent teacher accounts, hashed verification tokens, and teacher classroom records.
# Run migrations from: scripts/migrations/001_create_teachers_table.sql
DATABASE_URL=postgresql://postgres:password@localhost:5432/shikshagap?sslmode=require

# ==============================================================================
# 3. SMS VERIFICATION PROVIDER (TWILIO / MSG91 / GENERIC GATEWAY)
# ==============================================================================
# Select active SMS provider: 'twilio', 'msg91', 'custom', or leave empty for unconfigured notice
SMS_PROVIDER=twilio

# Twilio Credentials (Required if SMS_PROVIDER=twilio)
# Obtain from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Optional Generic HTTP SMS Gateway (if SMS_PROVIDER=custom)
# SMS_GATEWAY_URL=https://api.sms-provider.com/v1/send
# SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here

# ==============================================================================
# 4. EMAIL VERIFICATION & RECOVERY PROVIDER (RESEND / SENDGRID)
# ==============================================================================
# Select active email provider: 'resend', 'sendgrid', or leave empty for unconfigured notice
EMAIL_PROVIDER=resend

# Resend API Key (Required if EMAIL_PROVIDER=resend)
# Obtain from Resend Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sender email address
EMAIL_FROM=ShikshaGap Verification <noreply@shikshagap.in>

# ==============================================================================
# 5. VERIFICATION TIMING & RATE LIMITS
# ==============================================================================
# SMS OTP expiration in milliseconds (default: 600,000 = 10 minutes)
PHONE_OTP_EXPIRY_MS=600000

# Email verification token expiration in milliseconds (default: 86,400,000 = 24 hours)
EMAIL_TOKEN_EXPIRY_MS=86400000

# Password reset token expiration in milliseconds (default: 900,000 = 15 minutes)
PASSWORD_RESET_EXPIRY_MS=900000

# ==============================================================================
# 6. DEMO CREDENTIALS (EVALUATION ONLY)
# ==============================================================================
# Optional Demo Credentials for reviewer 1-click evaluation
DEMO_TEACHER_PASSWORD=
DEMO_TEACHER_HASH=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_HASH=

# ==============================================================================
# 7. PUBLIC SITE CONFIGURATION & DPDP COMPLIANCE
# ==============================================================================
NEXT_PUBLIC_CONTACT_EMAIL=contact@shikshagap.in
NEXT_PUBLIC_SITE_URL=https://shikshagap.vercel.app
NEXT_PUBLIC_LEGAL_ENTITY_NAME=ShikshaGap Educational Initiative
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Data Protection & Grievance Officer, ShikshaGap Privacy Cell

# Cron Secret for automated maintenance tasks (e.g. Vercel Cron: /api/cron/memory-upkeep)
CRON_SECRET=your_cron_secret_here
